# =============================================================================
# PromptCraft Backend - Environment Configuration
# =============================================================================
# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/promptcraft
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/promptcraft

# Redis
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# JWT
SECRET_KEY=change-this-to-a-secure-random-string-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# OAuth - Google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth - GitHub
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ACCESS_TOKEN=

# AI Provider API Keys
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SMTP / Email
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@promptcraft.com

# App
APP_NAME=PromptCraft
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# Sentry (optional)
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_AUTH_PER_MINUTE=20

# Free Tier Limits
FREE_DAILY_GENERATIONS=5
FREE_MAX_PROMPTS=50

# Pagination
PAGINATION_DEFAULT_SIZE=20
PAGINATION_MAX_SIZE=100
